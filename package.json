{
  "name": "@pwps/core",
  "version": "0.1.0",
  "description": "PWPS — Physical Workflow Protocol Specification. A vendor-neutral specification and toolchain for evidence-verifiable physical workflows.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guelmbaye/pwps.git"
  },
  "homepage": "https://github.com/guelmbaye/pwps#readme",
  "bugs": "https://github.com/guelmbaye/pwps/issues",
  "type": "module",
  "keywords": [
    "pwps",
    "physical-workflow",
    "protocol",
    "verification",
    "specification",
    "sop"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/pwps-0.1.schema.json"
  },
  "bin": {
    "pwps": "./bin/pwps.mjs"
  },
  "files": [
    "bin",
    "dist",
    "schema",
    "examples",
    "conformance",
    "SPEC.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pwps": "tsx src/cli.ts",
    "check": "npm run typecheck && npm test && npm run build && node bin/pwps.mjs validate examples/inbound-delivery.yaml"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
